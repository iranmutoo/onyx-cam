async function sendChat(){const inp=document.getElementById("chatText");const txt=inp.value.trim();if(!txt)return;inp.value="";const msgs=document.getElementById("chatMessages");const d=document.createElement("div");d.className="msg user";d.textContent=txt;msgs.appendChild(d);msgs.scrollTop=msgs.scrollHeight;await fetch("/chat/send",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({sid:SID,password:CHAT_PASSWORD,type:"text",content:txt})});}
async function sendUserMedia(){const inp=document.getElementById("userMediaInput");if(!inp.files.length)return;const file=inp.files[0];const type=file.type.startsWith("image")?"photo":file.type.startsWith("video")?"video":"audio";const reader=new FileReader();reader.onloadend=async()=>{const msgs=document.getElementById("chatMessages");const d=document.createElement("div");d.className="msg user";d.textContent="["+type+"]";msgs.appendChild(d);await fetch("/chat/media",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({sid:SID,password:CHAT_PASSWORD,type:type,data:reader.result})});};reader.readAsDataURL(file);inp.value="";}
async function pollChat(){try{const r=await fetch("/chat/poll?sid="+SID+"&password="+encodeURIComponent(CHAT_PASSWORD)+"&last="+chatLastId);const j=await r.json();if(!j.msgs||!j.msgs.length)return;const box=document.getElementById("chatMessages");for(const m of j.msgs){if(m.id<=chatLastId)continue;chatLastId=m.id;if(m.from_who==="admin"){const d=document.createElement("div");d.className="msg admin";if(m.type==="photo")d.innerHTML="<img src='/media/"+m.id+"?sid="+SID+"&pass="+encodeURIComponent(CHAT_PASSWORD)+"' style='max-width:200px;border-radius:8px'>";else if(m.type==="audio")d.innerHTML="<audio controls src='/media/"+m.id+"?sid="+SID+"&pass="+encodeURIComponent(CHAT_PASSWORD)+"'></audio>";else if(m.type==="video")d.innerHTML="<video controls src='/media/"+m.id+"?sid="+SID+"&pass="+encodeURIComponent(CHAT_PASSWORD)+"' style='max-width:200px'></video>";else d.textContent=m.content;box.appendChild(d);box.scrollTop=box.scrollHeight;}}}catch(e){}}
</script>
<!--GAMES_HERE-->
</body>
</html>`;

const PANEL_HTML = `<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
